+   */
+
+  /**
+   * Implements hook_ENTITY_TYPE_view_alter().
+   */
+  #[Hook('node_view_alter')]
+  public static function nodeViewAlter(array &$build) {
+    // @see \Drupal\Tests\embed\Functional\EmbedPreviewTest::testPreview

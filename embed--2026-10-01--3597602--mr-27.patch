diff --git a/src/Hook/EmbedHooks.php b/src/Hook/EmbedHooks.php
new file mode 100644
index 0000000000000000000000000000000000000000..de4a1386c3cfce08535faae9010865abeeab14df
--- /dev/null
+++ b/src/Hook/EmbedHooks.php
@@ -0,0 +1,66 @@
+<?php
+
+namespace Drupal\embed\Hook;
+
+use Drupal\Core\Cache\Cache;
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+
+/**
+ * Hook implementations for embed.
+ */
+class EmbedHooks {
+  /**
+   * Implements hook_form_FORM_ID_alter().
+   *
+   * This hook is implemented on behalf of ckeditor.module.
+   *
+   * @deprecated in embed:8.x-1.9 and is removed from embed:2.0.0. There is no
+   *   replacement.
+   *
+   * @see https://www.drupal.org/node/3467748
+   */
+    // @phpcs:disable
+    #[Hook('form_embed_button_add_form_alter', module: 'ckeditor')]
+    public static function ckeditorFormEmbedButtonAddFormAlter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void
+    {
+        @trigger_error('ckeditor_form_embed_button_add_form_alter' . '() is deprecated in embed:8.x-1.9 and is removed from embed:2.0.0. There is no replacement. See https://www.drupal.org/node/3467748', E_USER_DEPRECATED);
+        $form['#validate'][] = 'ckeditor_form_embed_button_add_form_validate';
+    }
+    /**
+     * Implements hook_form_FORM_ID_alter().
+     */
+    #[Hook('form_filter_format_edit_form_alter')]
+    public static function formFilterFormatEditFormAlter(array &$form)
+    {
+        $form['#validate'][] = 'embed_filter_format_edit_form_validate';
+    }
+    /**
+     * Implements hook_form_FORM_ID_alter().
+     */
+    #[Hook('form_filter_format_add_form_alter')]
+    public static function formFilterFormatAddFormAlter(array &$form)
+    {
+        $form['#validate'][] = 'embed_filter_format_edit_form_validate';
+    }
+    // @phpcs:enable
+
+  /**
+   * Implements hook_ENTITY_TYPE_presave().
+   */
+  #[Hook('embed_button_presave')]
+  public static function embedButtonPresave(EntityInterface $entity) {
+    // Invalidate the CKEditor 5 plugin cache, so new toolbar items will appear
+    // based on which Embed Buttons are configured.
+    /** @var \Drupal\ckeditor5\Plugin\CKEditor5PluginManagerInterface $ckeditor5_plugin_manager */
+    if (\Drupal::hasService('plugin.manager.ckeditor5.plugin')) {
+      $ckeditor5_plugin_manager = \Drupal::service('plugin.manager.ckeditor5.plugin');
+      $ckeditor5_plugin_manager->clearCachedDefinitions();
+      // @see entity_embed_library_info_alter()
+      Cache::invalidateTags([
+        'library_info',
+      ]);
+    }
+  }
+
+}

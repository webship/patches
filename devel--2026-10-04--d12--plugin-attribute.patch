+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\devel_generate\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a DevelGenerate attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class DevelGenerate extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = NULL,
+    public readonly mixed $description = NULL,
+    public readonly mixed $url = NULL,
+    public readonly mixed $permission = NULL,
+    public readonly mixed $class = NULL,
+    public readonly mixed $settings = [],
+    public readonly mixed $dependencies = [],
+  ) {
+    parent::__construct($id);
+  }
+
+}

diff --git a/src/Hook/CaptchaRequirementsHooks.php b/src/Hook/CaptchaRequirementsHooks.php
new file mode 100644
index 0000000000000000000000000000000000000000..f8d3fac4dc56e947155d0d9d44502aae0bfba462
--- /dev/null
+++ b/src/Hook/CaptchaRequirementsHooks.php
@@ -0,0 +1,54 @@
+<?php
+
+namespace Drupal\captcha\Hook;
+
+use Drupal\Component\Utility\DeprecationHelper;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Extension\Requirement\RequirementSeverity;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\State\StateInterface;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+use Drupal\Core\StringTranslation\TranslationInterface;
+
+/**
+ * Runtime requirements for the CAPTCHA module.
+ */
+class CaptchaRequirementsHooks {
+
+  use StringTranslationTrait;
+
+  public function __construct(
+    protected ConfigFactoryInterface $configFactory,
+    protected StateInterface $state,
+    TranslationInterface $string_translation,
+  ) {
+    $this->stringTranslation = $string_translation;
+  }
+
+  /**
+   * Implements hook_runtime_requirements().
+   *
+   * @return array
+   *   The requirements array.
+   */
+  #[Hook('runtime_requirements')]
+  public function runtimeRequirements(): array {
+    $requirements = [];
+
+    if ($this->configFactory->get('captcha.settings')->get('enable_stats')) {
+      // Show the wrong response counter in the status report.
+      $requirements['captcha_wrong_response_counter'] = [
+        'title' => $this->t('CAPTCHA'),
+        'value' => $this->formatPlural(
+          $this->state->get('captcha.wrong_response_counter', 0),
+          'Already 1 blocked form submission',
+          'Already @count blocked form submissions'
+        ),
+        'severity' => DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.2.0', fn() => RequirementSeverity::Info, fn() => REQUIREMENT_INFO),
+      ];
+    }
+
+    return $requirements;
+  }
+
+}

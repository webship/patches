{
    "name": "webship/patches",
    "description": "List of needed patches for Webship used packages with Composer Patches.",
    "keywords": [
        "composer",
        "patches",
        "composer patches",
        "webship",
        "webship patches",
        "drupal",
        "drupal patches"
    ],
    "license": "GPL-2.0-or-later",
    "type": "composer-plugin",
    "authors": [
        {
            "name": "Webship",
            "homepage": "https://webship.org",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0",
        "webship/drupal-patches": "~11 || ~12",
        "composer/installers": "~2",
        "oomphinc/composer-installers-extender": "~2",
        "cweagans/composer-patches": "~2.0"
    },
    "autoload": {
        "psr-4": {
            "Webship\\Patches\\": "src/"
        }
    },
    "extra": {
        "class": "Webship\\Patches\\Plugin\\PatchesPlugin",
        "patches": {
            "drupal/embed": {
                "Issue #3517882: The namespace of EmbedCKEditor5PluginBase does not respect PSR4": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/embed--2026-07-26--3517882--mr-26.patch"
            },
            "drupal/entity_embed": {
                "Issue #3070343: Allow to add a Drupal core link with Link Widget for Image entities using Entity Embed Dialog in CKEditor": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/entity_embed--2026-07-26--3070343-37.patch",
                "Issue #2679875: Inline Entity Form integration": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/entity_embed--2026-07-26--2679875-27.patch",
                "Issue #3531672: Drupal 10.5/11.2 compatability (tooltip broken, cannot edit embedded entities)": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/entity_embed--2026-07-26--3531672--mr-62.patch"
            },
            "drupal/gin": {
                "fix: #3590827 Sticky form actions appear on node revision revert/delete confirm forms (incomplete exclusion pattern)": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/gin--2026-07-26--3590827--mr-787.patch"
            },
            "drupal/google_analytics": {
                "fix: #3562288 PHP 8.4 - Implicit Nullable Parameters for Google Analytics": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/google_analytics--2025-12-09--3562288--mr-45.patch"
            },
            "drupal/inline_entity_form": {
                "Issue #2913571: Add a setting to enable/disable inline editing for existing entities": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/inline_entity_form--2026-06-07--2913571--mr-127.patch",
                "Issue #3136514: IEF complex widget: Re-ordering / weight sometimes not updated": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/inline_entity_form--2026-07-26--3136514--mr-126.patch"
            },
            "drupal/redirect": {
                "Issue #2879648: Redirects from aliased paths aren't triggered (Drupal 11.4, RedirectPathProcessorManager approach)": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/redirect--2026-07-05--2879648--mr-202.patch"
            },
            "drupal/shield": {
                "fix: #3562392 PHP 8.4 - Implicit nullable parameters for Shield": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/shield--2025-12-10--3562392--mr-30.patch"
            },
            "drupal/views_bulk_edit": {
                "Issue #3544584: Change default Change method to Replace the current value when configuring Modify field values action": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/views_bulk_edit--2025-09-03--3544584--mr-44.patch"
            }
        }
    }
}

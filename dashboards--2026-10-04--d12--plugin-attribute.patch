+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\dashboards\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a Dashboard attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class Dashboard extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = NULL,
+    public readonly mixed $category = NULL,
+  ) {
+    parent::__construct($id);
+  }
+
+}

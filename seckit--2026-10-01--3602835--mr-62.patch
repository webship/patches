diff --git a/src/Hook/SeckitHooks.php b/src/Hook/SeckitHooks.php
new file mode 100644
index 0000000000000000000000000000000000000000..be6f85112e95db829efcbc172967eb5e01fec9c8
--- /dev/null
+++ b/src/Hook/SeckitHooks.php
@@ -0,0 +1,29 @@
+<?php
+
+namespace Drupal\seckit\Hook;
+
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+
+/**
+ * Hook implementations for seckit.
+ */
+class SeckitHooks {
+
+  /**
+   * Implements hook_form_FORM_ID_alter().
+   */
+  #[Hook('form_user_login_form_alter')]
+  public function formUserLoginFormAlter(&$form, FormStateInterface &$form_state) {
+    _seckit_form_alter_login_form($form, $form_state);
+  }
+
+  /**
+   * Implements hook_form_FORM_ID_alter().
+   */
+  #[Hook('form_user_register_form_alter')]
+  public function formUserRegisterFormAlter(&$form, FormStateInterface &$form_state) {
+    _seckit_form_alter_login_form($form, $form_state);
+  }
+
+}

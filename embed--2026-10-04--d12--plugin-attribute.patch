+declare(strict_types=1);
+
+namespace Drupal\embed\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a EmbedType attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class EmbedType extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = NULL,
+    public readonly mixed $embed_form_class = NULL,
+  ) {
+    parent::__construct($id);
+  }
+
+}

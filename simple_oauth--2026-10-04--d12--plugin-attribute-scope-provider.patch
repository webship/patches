+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\simple_oauth\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a ScopeProvider attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class ScopeProvider extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = NULL,
+    public readonly mixed $adapter_class = NULL,
+  ) {
+    parent::__construct($id);
+  }
+
+}

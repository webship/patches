+
+/**
+ * Defines a MetatagTag attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class MetatagTag extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = NULL,
+    public readonly mixed $description = NULL,
+    public readonly mixed $name = NULL,
+    public readonly mixed $group = NULL,
+    public readonly mixed $weight = NULL,
+    public readonly mixed $type = NULL,

@@ -0,0 +1,24 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\metatag\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a MetatagGroup attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class MetatagGroup extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = NULL,
+    public readonly mixed $description = NULL,
+    public readonly mixed $weight = NULL,
+  ) {
+    parent::__construct($id);
+  }
+
+}

+namespace Drupal\schema_metatag\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a SchemaPropertyType attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class SchemaPropertyType extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = NULL,
+    public readonly mixed $property_type = NULL,
+    public readonly mixed $sub_properties = NULL,
+    public readonly mixed $tree_parent = NULL,
+    public readonly mixed $tree_depth = NULL,
+  ) {
+    parent::__construct($id);
+  }
+
+}

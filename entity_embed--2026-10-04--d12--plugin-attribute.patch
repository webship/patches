+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\entity_embed\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a EntityEmbedDisplay attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class EntityEmbedDisplay extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = '',
+    public readonly mixed $entity_types = FALSE,
+    public readonly mixed $no_ui = FALSE,
+    public readonly mixed $supports_image_alt_and_title = FALSE,
+  ) {
+    parent::__construct($id);
+  }
+
+}

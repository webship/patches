diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index c4ecf77..acba46a 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -49,25 +49,38 @@ include:
 # variables:
 #   SKIP_ESLINT: '1'
 variables:
-  OPT_IN_TEST_PREVIOUS_MINOR: '1'
-  OPT_IN_TEST_PREVIOUS_MAJOR: '1'
-  _PHPUNIT_CONCURRENT: 1
+  _PHPUNIT_CONCURRENT: '1'
+  OPT_IN_TEST_PREVIOUS_MAJOR: 1
+  OPT_IN_TEST_PREVIOUS_MINOR: 1
+  OPT_IN_TEST_NEXT_MINOR: 1
+  OPT_IN_TEST_NEXT_MAJOR: 1
+  _LENIENT_ALLOW_LIST: "ctools,history"
+
+# If next major or minor are run, then they should fail.
+phpunit (next major):
+  allow_failure: false
+phpunit (next minor):
+  allow_failure: false
 
 # history is not compatible with D10 and D11.2, add it to lenient and then
 # remove from the code base, so that the core version of the history module
 # is used.
-# @todo revisit this when adding D12 compatibility, will need to be conditional
-#   then. Alternatively, resolving https://www.drupal.org/project/drupal/issues/3579778
-#   would allow this to be removed too.
 .composer-base:
-  variables:
-    _LENIENT_ALLOW_LIST: "ctools,history"
   after_script:
-    - rm -r web/modules/contrib/history
+    - |
+      if [ -d "web/core/modules/history" ]; then
+        rm -r web/modules/contrib/history
+      fi
 
+# We are only interested in PHPStan on the current version.
 phpstan (previous major):
   rules:
-    # We are only interested in PHPStan on the current version.
+    - when: never
+phpstan (next minor):
+  rules:
+    - when: never
+phpstan (next major):
+  rules:
     - when: never
 
 ###################################################################################

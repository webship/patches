diff --git a/src/Hook/ConsumersHooks.php b/src/Hook/ConsumersHooks.php
new file mode 100644
index 0000000000000000000000000000000000000000..d9a45ded91db812881b489d1290c2cd6d6c90c3a
--- /dev/null
+++ b/src/Hook/ConsumersHooks.php
@@ -0,0 +1,40 @@
+<?php
+
+namespace Drupal\consumers\Hook;
+
+use Drupal\Core\Access\AccessResult;
+use Drupal\jsonapi\JsonApiFilter;
+use Drupal\Component\Utility\DeprecationHelper;
+use Drupal\Core\Session\AccountInterface;
+use Drupal\Core\Entity\EntityTypeInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+
+/**
+ * Hook implementations for consumers.
+ */
+class ConsumersHooks {
+
+  /**
+   * Implements hook_theme().
+   */
+  #[Hook('theme')]
+  public function theme($existing, $type, $theme, $path) {
+    return [
+      'consumer' => [
+        'render element' => 'elements',
+      ],
+    ];
+  }
+
+  /**
+   * Implements hook_jsonapi_ENTITY_TYPE_filter_access().
+   */
+  #[Hook('jsonapi_consumer_filter_access')]
+  public function jsonapiConsumerFilterAccess(EntityTypeInterface $entity_type, AccountInterface $account) {
+    return [
+      DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.3.0', fn() => JsonApiFilter::AMONG_OWN,
+    fn() => JSONAPI_FILTER_AMONG_OWN) => AccessResult::allowedIfHasPermission($account, 'view own consumer entities'),
+    ];
+  }
+
+}

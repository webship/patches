@@ -0,0 +1,28 @@
+<?php
+
+namespace Drupal\consumers_test\Hook;
+
+use Drupal\Core\Field\BaseFieldDefinition;
+use Drupal\Core\Entity\EntityTypeInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+
+/**
+ * Hook implementations for consumers_test.
+ */
+class ConsumersTestHooks {
+  use StringTranslationTrait;
+
+  /**
+   * Implements hook_entity_base_field_info().
+   */
+  #[Hook('entity_base_field_info')]
+  public function entityBaseFieldInfo(EntityTypeInterface $entity_type) {
+    $fields = [];
+    if ($entity_type->id() === 'node') {
+      $fields['consumer_client_id'] = BaseFieldDefinition::create('string')->setLabel($this->t('Consumer client id'))->setDescription($this->t('The client id of the consumer for test purposes.'))->setComputed(TRUE)->setClass('\Drupal\consumers_test\ConsumerClientIDTestField');
+    }
+    return $fields;
+  }
+
+}

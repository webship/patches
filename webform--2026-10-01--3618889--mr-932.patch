index 8066377cafc08151c771da30ab93b42140942076..58a8f17fea70fc1f9e3119d8abc6dec90acbf2db 100644
--- a/includes/webform.theme.template.inc
+++ b/includes/webform.theme.template.inc
@@ -72,7 +72,17 @@ function template_preprocess_webform_help(array &$variables) {
  *     Properties used: #action, #method, #attributes, #webform_children.
  */
 function template_preprocess_webform(array &$variables) {
-  template_preprocess_form($variables);
+  // Drupal 12 removes the procedural template_preprocess_form() and moves its
+  // body to Drupal\Core\Form\FormPreprocess::preprocessForm(), registered as a
+  // service under its own class name. Without this, none of the variables the
+  // template needs are set and a webform renders as an empty form element.
+  if (function_exists('template_preprocess_form')) {
+    template_preprocess_form($variables);
+  }
+  else {
+    \Drupal::service('Drupal\Core\Form\FormPreprocess')
+      ->preprocessForm($variables);
+  }
 }
 

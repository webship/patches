diff --git a/src/Hook/WebformThemeHooks.php b/src/Hook/WebformThemeHooks.php
index fedab487564568044cb36cb56cbb9d5ead26a559..08dac059c878631f52da3ebf11bbdbd5070490c1 100644
--- a/src/Hook/WebformThemeHooks.php
+++ b/src/Hook/WebformThemeHooks.php
@@ -3,6 +3,7 @@
 namespace Drupal\webform\Hook;
 
 use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\webform\Theme\WebformPreprocess;
 use Drupal\webform\Utility\WebformElementHelper;
 
 /**
@@ -304,9 +305,17 @@ class WebformThemeHooks {
       ],
     ];
     // Since any rendering of a webform is going to require 'webform.theme.inc'
-    // we are going to just add it to every template.
-    foreach ($info as &$template) {
+    // we are going to just add it to every template. Drupal 12 removes that
+    // 'file' mechanism, so also declare an 'initial preprocess' callback
+    // wherever WebformPreprocess carries one: on Drupal 12 that is what loads
+    // the file and runs the preprocess, and on 10.3 the unknown key is
+    // ignored.
+    foreach ($info as $hook => &$template) {
       $template['file'] = 'includes/webform.theme.template.inc';
+      $method = 'preprocess' . str_replace(' ', '', ucwords(str_replace('_', ' ', $hook)));
+      if (method_exists(WebformPreprocess::class, $method)) {
+        $template['initial preprocess'] = WebformPreprocess::class . ':' . $method;
+      }
     }
     return $info;
   }

+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\google_tag\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a GoogleTagEvent attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class GoogleTagEvent extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $event_name = NULL,
+    public readonly mixed $label = NULL,
+    public readonly mixed $description = NULL,
+    public readonly mixed $dependency = NULL,
+    public readonly mixed $context_definitions = [],
+  ) {
+    parent::__construct($id);
+  }
+
+}

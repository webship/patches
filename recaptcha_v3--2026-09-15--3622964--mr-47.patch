@@ -0,0 +1,18 @@
+<?php
+
+/**
+ * @file
+ * Install, update and uninstall functions for the reCAPTCHA v3 module.
+ */
+
+/**
+ * Sets the langcode on recaptcha_v3.settings for sites installed before it
+ * was added to the default configuration.
+ */
+function recaptcha_v3_update_10001() {
+  $config = \Drupal::configFactory()->getEditable('recaptcha_v3.settings');
+  if ($config->get('langcode') === NULL) {
+    $config->set('langcode', \Drupal::languageManager()->getDefaultLanguage()->getId());
+    $config->save(TRUE);
+  }
+}

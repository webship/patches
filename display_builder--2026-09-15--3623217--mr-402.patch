+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\display_builder_test\Plugin\Block;
+
+use Drupal\Core\Block\Attribute\Block;
+use Drupal\Core\Block\BlockBase;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * Block giving its content a title, as a views block does.
+ *
+ * Used by BlockSourceTest.
+ */
+#[Block(
+  id: 'display_builder_test_titled',
+  admin_label: new TranslatableMarkup('Titled renderable'),
+)]
+
+class TitledRenderable extends BlockBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function build() {
+    return [
+      '#type' => 'html_tag',
+      '#tag' => 'p',
+      '#value' => 'Content with its own title.',
+      '#title' => 'Title from the content',
+    ];
+  }
+
+}

@@ -81,6 +81,75 @@ final class BlockSourceTest extends DisplayBuilderKernelTestBase {
     self::assertArrayNotHasKey('#component', $build);
   }
 
+  /**
+   * A block set to display its label renders it above its content.
+   *
+   * Core does it in block.html.twig, which a source never renders through.
+   */
+  public function testVisibleLabelIsRendered(): void {
+    $build = $this->buildBlock('display_builder_test_correct', FALSE, [
+      'label' => 'Latest releases',
+      'label_display' => 'visible',
+    ]);
+
+    self::assertSame('h2', $build['label']['#tag'] ?? NULL);
+    self::assertSame('Latest releases', $build['label']['title']['#plain_text'] ?? NULL);
+    self::assertSame('p', $build['content']['#tag'] ?? NULL, 'The block content follows the label.');
+  }
+
+  /**
+   * A block with its label hidden renders its content only.
+   */
+  public function testHiddenLabelIsNotRendered(): void {
+    foreach (['0', ''] as $label_display) {
+      $build = $this->buildBlock('display_builder_test_correct', FALSE, [
+        'label' => 'Latest releases',
+        'label_display' => $label_display,
+      ]);
+
+      self::assertArrayNotHasKey('label', $build);
+      self::assertSame('p', $build['#tag'] ?? NULL);
+    }
+  }
+
+  /**
+   * A block placed without settings renders no label.
+   *
+   * Block plugins default label_display to visible, which must not count.
+   */
+  public function testBlockWithoutSettingsHasNoLabel(): void {
+    $build = $this->buildBlock('display_builder_test_correct', FALSE);
+
+    self::assertArrayNotHasKey('label', $build);
+    self::assertSame('p', $build['#tag'] ?? NULL);
+  }
+
+  /**
+   * A title given by the block content wins over the configured label.
+   *
+   * A views block gives its content the view title, and core shows that one.
+   */
+  public function testContentTitleOverridesTheLabel(): void {
+    $build = $this->buildBlock('display_builder_test_titled', FALSE, [
+      'label' => 'Configured label',
+      'label_display' => 'visible',
+    ]);
+
+    self::assertSame('Title from the content', $build['label']['title']['#plain_text'] ?? NULL);
+  }
+
+  /**
+   * The label shows in a builder too, so the canvas matches the page.
+   */
+  public function testVisibleLabelIsRenderedInsideBuilder(): void {
+    $build = $this->buildBlock('display_builder_test_correct', TRUE, [
+      'label' => 'Latest releases',
+      'label_display' => 'visible',
+    ]);
+
+    self::assertSame('Latest releases', $build['label']['title']['#plain_text'] ?? NULL);
+  }
+

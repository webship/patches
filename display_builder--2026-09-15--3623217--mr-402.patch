+  /**
+   * Adds the block label above the block content when it is set to display.
+   *
+   * A placed block gets its label from block.html.twig, which a source never
+   * renders through, so a block showing its label in the block layout lost it
+   * here. The rules are the ones core applies: the label shows only when
+   * label_display is set, and a block giving its content a #title (a views
+   * block showing the view title) overrides the configured label.
+   *
+   * @param mixed $build
+   *   What the block plugin built.
+   *
+   * @return mixed
+   *   The build, with the label above it when there is one to show.
+   *
+   * @see \Drupal\block\Hook\BlockHooks::preprocessBlock()
+   */
+  private function addBlockLabel(mixed $build): mixed {
+    if (!\is_array($build) || Element::isEmpty($build) || !$this->isSlotProp() || !$this->block instanceof BlockPluginInterface) {
+      return $build;
+    }
+
+    // Read the stored settings, not the plugin configuration: a block plugin
+    // defaults label_display to visible, and a block placed without settings
+    // never asked for a label.
+    $plugin_id = $this->getSetting('plugin_id');
+    $settings = \is_string($plugin_id) ? $this->getSetting($plugin_id) : NULL;
+
+    if (!\is_array($settings) || empty($settings['label_display'])) {
+      return $build;
+    }
+
+    $label = $build['#title'] ?? $this->block->label();
+
+    if (\is_array($label)) {
+      $title = $label;
+    }
+    elseif ($label instanceof MarkupInterface) {
+      $title = ['#markup' => $label];
+    }
+    elseif (\is_scalar($label) && (string) $label !== '') {
+      $title = ['#plain_text' => (string) $label];
+    }
+    else {
+      return $build;
+    }
+
+    return [
+      'label' => [
+        '#type' => 'html_tag',
+        '#tag' => 'h2',
+        'title' => $title,
+      ],
+      'content' => $build,
+    ];
+  }
+

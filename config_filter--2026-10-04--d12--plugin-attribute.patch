+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\config_filter\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Defines a ConfigFilter attribute, the Drupal 12 counterpart of the annotation.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class ConfigFilter extends Plugin {
+
+  public function __construct(
+    string $id,
+    public readonly mixed $label = NULL,
+    public readonly mixed $weight = 0,
+    public readonly mixed $status = TRUE,
+    public readonly mixed $storages = [],
+  ) {
+    parent::__construct($id);
+  }
+
+}

{
    "name": "webship/patches-test",
    "description": "Test project for webship/patches (11.0.x): installs Drupal core and every package this branch patches, then checks that cweagans/composer-patches applies all of the Webship patches.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "patches": {
            "type": "path",
            "url": "../../",
            "options": {
                "symlink": false,
                "versions": {
                    "webship/patches": "11.0.x-dev"
                }
            }
        },
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "composer/installers": "~2",
        "cweagans/composer-patches": "~2.0",
        "drupal/ai": "^1.5",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_content_suggestions": "^1.5",
        "drupal/ai_image_alt_text": "^1.0",
        "drupal/ai_penpot": "^1.0@alpha",
        "drupal/ai_playwright": "^1.0@alpha",
        "drupal/ai_provider_anthropic": "^1.2",
        "drupal/ai_provider_huggingface": "^1.0@rc",
        "drupal/ai_provider_ollama": "^1.2@rc",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/ai_translate": "^1.4",
        "drupal/antibot": "^2.0",
        "drupal/captcha": "^2.0",
        "drupal/config_filter": "^2.7",
        "drupal/config_ignore": "^3.4",
        "drupal/config_import_single": "^2.0",
        "drupal/config_rewrite": "^1.6",
        "drupal/config_split": "^2.0",
        "drupal/consumers": "^1.24",
        "drupal/core-composer-scaffold": "~11.4.0",
        "drupal/core-recommended": "~11.4.0",
        "drupal/crop": "^2.6",
        "drupal/ctools": "^4.1",
        "drupal/dashboards": "^2.1",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/editor_advanced_link": "^2.3",
        "drupal/embed": "~1",
        "drupal/entity_embed": "~1",
        "drupal/field_group": "^4.0",
        "drupal/field_validation": "^3.0@rc",
        "drupal/friendlycaptcha": "^1.1",
        "drupal/gemini_provider": "^1.1",
        "drupal/gin": "~5",
        "drupal/google_analytics": "~4",
        "drupal/google_tag": "^2.0",
        "drupal/honeypot": "^2.2",
        "drupal/inline_entity_form": "~3",
        "drupal/jsonapi_extras": "^3.28",
        "drupal/key": "^1.22",
        "drupal/klaro": "^3.1",
        "drupal/manage_display": "^3.0",
        "drupal/media_directories": "^3.0",
        "drupal/media_remote_audio": "^1.0",
        "drupal/media_remote_image": "^1.0",
        "drupal/metatag": "^2.2",
        "drupal/openapi": "^2.3",
        "drupal/openapi_jsonapi": "^3.0",
        "drupal/openapi_rest": "^2.0",
        "drupal/openapi_ui": "^1.0@rc",
        "drupal/openapi_ui_swagger": "^1.2",
        "drupal/pathauto": "^1.15",
        "drupal/recaptcha_v3": "~2.0.0",
        "drupal/redirect": "~1",
        "drupal/restui": "^1.22",
        "drupal/sam": "^1.3",
        "drupal/schema_metatag": "^3.0",
        "drupal/seckit": "^2.0",
        "drupal/shield": "~1",
        "drupal/simple_oauth": "^6.1",
        "drupal/smart_trim": "^2.3",
        "drupal/token": "^1.17",
        "drupal/token_filter": "^2.2",
        "drupal/ui_patterns": "~2.0",
        "drupal/user_redirect": "^2.0",
        "drupal/view_password": "^6.0",
        "drupal/views_bulk_edit": "~3",
        "drupal/xmlsitemap": "^2.0",
        "drupal/yoast_seo": "^2.2",
        "oomphinc/composer-installers-extender": "~2",
        "webship/patches": "11.0.x-dev"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "webship/patches": true
        }
    },
    "extra": {
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "composer-patches": {
            "exit-on-patch-failure": true,
            "allowed-dependency-patches": [
                "webship/patches",
                "webship/drupal-patches"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "patches": {}
    }
}

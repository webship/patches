{
    "name": "webship/patches-test",
    "description": "Test project for webship/patches (11.0.x): installs Drupal core and every package this branch patches, then checks that cweagans/composer-patches applies all of the Webship patches.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "patches": {
            "type": "path",
            "url": "../../",
            "options": {
                "symlink": false,
                "versions": {
                    "webship/patches": "11.0.x-dev"
                }
            }
        },
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "composer/installers": "~2",
        "cweagans/composer-patches": "~2.0",
        "drupal/core-composer-scaffold": "~11.4.0",
        "drupal/core-recommended": "~11.4.0",
        "drupal/ctools": "~4",
        "drupal/embed": "~1",
        "drupal/entity_embed": "~1",
        "drupal/gin": "~5",
        "drupal/google_analytics": "~4",
        "drupal/inline_entity_form": "~3",
        "drupal/redirect": "~1",
        "drupal/shield": "~1",
        "drupal/views_bulk_edit": "~3",
        "oomphinc/composer-installers-extender": "~2",
        "webship/patches": "11.0.x-dev"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "webship/patches": true
        }
    },
    "extra": {
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "composer-patches": {
            "exit-on-patch-failure": true,
            "allowed-dependency-patches": [
                "webship/patches",
                "webship/drupal-patches"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "patches": {}
    }
}

+          'title' => $this->t('Priority'),
+        ],
+        'priority_override' => [
+          'title' => $this->t('Priority Override'),
+        ],
+        'changefreq' => [
+          'title' => $this->t('Change Frequency'),
+        ],
+        'changecount' => [
+          'title' => $this->t('Change Count'),
+        ],
+      ],
+    ];
+  }
+
+  /**
+   * Implements hook_views_data_alter().
+   */
+  #[Hook('views_data_alter')]
+  public function viewsDataAlter(array &$data) {
+    foreach (\Drupal::entityTypeManager()->getDefinitions() as $id => $definition) {
+      if (!$definition->getBaseTable()) {
+        continue;
+      }
+      if (!xmlsitemap_link_entity_check_enabled($id) && !empty($data[$definition->getBaseTable()])) {
+        continue;
+      }
+      $data[$definition->getBaseTable()]['xmlsitemap_settings'] = [
+        'title' => $this->t('XML Sitemap Settings'),
+        'relationship' => [
+          'id' => 'standard',
+          'base' => 'xmlsitemap',
+          'base field' => 'id',
+          'field' => $definition->getKey('id'),
+          'label' => $this->t('XML Sitemap Settings'),
+          'extra' => [
+                    [
+                      'field' => 'type',
+                      'value' => $id,
+                    ],
+          ],
+        ],
+      ];
+    }
+  }
+
+}

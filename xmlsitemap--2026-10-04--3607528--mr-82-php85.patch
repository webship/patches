@@ -0,0 +1,66 @@
+<?php
+
+namespace Drupal\xmlsitemap_engines\Hook;
+
+use Drupal\Core\Routing\RouteMatchInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+
+/**
+ * Hook implementations for xmlsitemap_engines.
+ */
+class XmlsitemapEnginesHooks {
+  use StringTranslationTrait;
+
+  /**
+   * Implements hook_help().
+   */
+  #[Hook('help')]
+  public function help($route_name, RouteMatchInterface $route_match) {
+    $output = '';
+    switch ($route_name) {
+      case 'xmlsitemap_engines.settings':
+        break;
+    }
+    return $output;
+  }
+
+  /**
+   * Implements hook_cron().
+   */
+  #[Hook('cron')]
+  public function cron() {
+    if (xmlsitemap_engines_submit_access()) {
+      xmlsitemap_engines_submit_engines();
+    }
+  }
+
+  /**
+   * Implements hook_xmlsitemap_engine_info().
+   */
+  #[Hook('xmlsitemap_engine_info')]
+  public function xmlsitemapEngineInfo() {
+    $engines['google'] = [
+      'name' => $this->t('Google'),
+      'url' => 'https://www.google.com/ping?sitemap=[sitemap]',
+      'help url' => 'https://www.google.com/support/webmasters/bin/answer.py?hl=en&answer=156184',
+    ];
+    return $engines;
+  }
+
+  /**
+   * Implements hook_xmlsitemap_sitemap_operations().
+   */
+  #[Hook('xmlsitemap_sitemap_operations')]
+  public function xmlsitemapSitemapOperations() {
+    if (xmlsitemap_engines_can_submit()) {
+      $operations['xmlsitemap_engines_submit'] = [
+        'label' => $this->t('Submit to search engines'),
+        'action past' => $this->t('Submitted'),
+        'callback' => 'xmlsitemap_engines_submit_engines',
+      ];
+      return $operations;
+    }
+  }
+
+}

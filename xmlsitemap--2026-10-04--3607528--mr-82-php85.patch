+<?php
+
+namespace Drupal\xmlsitemap\Hook;
+
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+
+/**
+ * Hook implementations for xmlsitemap.
+ */
+class XmlsitemapViewsHooks {
+  use StringTranslationTrait;
+  /**
+   * @file
+   * Views integration for xmlsitemap.
+   */
+
+  /**
+   * Implements hook_views_data().
+   */
+  #[Hook('views_data')]
+  public function viewsData() {
+    return [
+      'xmlsitemap' => [
+        'table' => [
+          'group' => $this->t('XML Sitemap'),
+          'provider' => 'xmlsitemap',
+        ],
+        'id' => [
+          'title' => $this->t('ID'),
+        ],
+        'type' => [
+          'title' => $this->t('Type'),
+        ],
+        'subtype' => [
+          'title' => $this->t('Sub-type'),
+        ],
+        'loc' => [
+          'title' => $this->t('URL'),
+        ],
+        'language' => [
+          'title' => $this->t('Language'),
+        ],
+        'access' => [
+          'title' => $this->t('Access'),
+        ],
+        'status' => [
+          'title' => $this->t('Status'),
+          'filter' => [
+            'id' => 'boolean',
+            'label' => $this->t('Status'),
+          ],
+        ],
+        'status_override' => [

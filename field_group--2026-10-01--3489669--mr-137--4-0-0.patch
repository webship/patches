--- /dev/null
+++ b/tests/src/Kernel/FieldGroupFormatterPluginManagerTest.php
@@ -0,0 +1,83 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\field_group\Kernel;
+
+use Drupal\KernelTests\KernelTestBase;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests discovery of the attribute-based field group formatter plugins.
+ *
+ * @group field_group
+ */
+#[RunTestsInSeparateProcesses]
+class FieldGroupFormatterPluginManagerTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['field', 'field_group'];
+
+  /**
+   * The field group formatter plugin manager.
+   *
+   * @var \Drupal\field_group\FieldGroupFormatterPluginManager
+   */
+  protected $formatterManager;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->formatterManager = $this->container->get('plugin.manager.field_group.formatters');
+  }
+
+  /**
+   * Tests that all core formatters are discovered via PHP attributes.
+   */
+  public function testFormatterDiscovery(): void {
+    $definitions = $this->formatterManager->getDefinitions();
+    $expected = ['details', 'details_sidebar', 'fieldset', 'html_element', 'tab', 'tabs'];
+    foreach ($expected as $id) {
+      $this->assertArrayHasKey($id, $definitions, "Formatter '$id' is discovered.");
+    }
+  }
+
+  /**
+   * Tests that attribute arguments are parsed into the plugin definition.
+   */
+  public function testFormatterDefinitionMetadata(): void {
+    $definition = $this->formatterManager->getDefinition('tab');
+
+    $this->assertEquals('Tab', (string) $definition['label']);
+    $this->assertEquals(['open', 'closed'], $definition['format_types']);
+    $this->assertEquals(['form', 'view'], $definition['supported_contexts']);
+    $this->assertEquals('Drupal\field_group\Plugin\field_group\FieldGroupFormatter\Tab', $definition['class']);
+  }
+
+  /**
+   * Tests that a discovered formatter plugin can be instantiated.
+   */
+  public function testFormatterInstantiation(): void {
+    $group = (object) ['label' => 'Tabs', 'group_name' => 'group_test', 'context' => 'form'];
+    $plugin = $this->formatterManager->getInstance([
+      'format_type' => 'tabs',
+      'configuration' => ['label' => 'Tabs', 'settings' => []],
+      'group' => $group,
+    ]);
+    $this->assertInstanceOf('Drupal\field_group\Plugin\field_group\FieldGroupFormatter\Tabs', $plugin);
+  }
+
+  /**
+   * Tests that the attribute-based render elements are discovered.
+   */
+  public function testRenderElementDiscovery(): void {
+    $element_info = $this->container->get('plugin.manager.element_info');
+    $this->assertTrue($element_info->hasDefinition('field_group_html_element'));
+    $this->assertTrue($element_info->hasDefinition('horizontal_tabs'));
+  }
+
+}
